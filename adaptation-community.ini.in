[adaptation-community]
repos = adaptation-community
pattern = Feature community adaptation
description = Enable ssu for community ports

[repositories]
adaptation-community = https://repo.sailfishos.org/obs/nemo:/@FLAVOUR@:/hw:/@VENDOR@:/@DEVICE@:/%(releaseMajorMinor)/sailfishos_%(releaseMajorMinor)_%(arch)
adaptation-halium = https://repo.sailfishos.org/obs/nemo:/@FLAVOUR@:/hw:/halium:/@HALIUMRELEASE@:/%(releaseMajorMinor)/sailfishos_%(releaseMajorMinor)_%(arch)
